# Safe local mode: no Telegram account or token is used.
APP_MODE=demo
PORT=3000
HOST=127.0.0.1
DATA_DIRECTORY=./data
NODE_ENV=development

# Required only for APP_MODE=production. Keep these values server-side.
# TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
# WEB_APP_URL=https://your-domain.example
# TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
